{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Ascent Verify",
  "colors": {
    "primary": "#00FFFA",
    "light": "#00FFFA",
    "dark": "#00FFFA"
  },
  "favicon": {
    "light": "/images/Gemini_Generated_Image_l1ixcdl1ixcdl1ix-removebg-preview.png.webp",
    "dark": "/images/Gemini_Generated_Image_l1ixcdl1ixcdl1ix-removebg-preview.png.webp"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://help.ascent.directory/",
          "icon": "book-open-cover"
        }
      ]
    },
    "pages": [
      "index",
      {
        "group": "Regulations & Legal",
        "pages": [
          "application-requirements",
          "affiliate-requirements",
          "small-server-program",
          "terms-of-service",
          "privacy-policy",
          "partnership-agreement",
          "non-certification-agreement"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg",
    "href": "https://ascentverify.xyz"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:help@ascent.directory"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Ascent",
      "href": "https://ascent.directory"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/D3v9PcbXxd"
    }
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "dark": "#FFFFFF"
    },
    "decoration": "gradient"
  },
  "banner": {
    "content": "V1 of Ascent Directory is Out! Documentation updates are still occuring...",
    "dismissible": true
  },
  "description": "Ascent Verify's Official Help Site!",
  "fonts": {
    "family": "Plus Jakarta Sans"
  }
}
